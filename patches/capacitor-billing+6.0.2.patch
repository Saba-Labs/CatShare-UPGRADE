 public class BillingPlugin extends Plugin {
 
+    /**
+     * Picks the correct {@link ProductDetails.SubscriptionOfferDetails} when a subscription product has
+     * multiple base plans (e.g. legacy inactive + active). Play Billing does not guarantee offer order.
+     */
+    private static ProductDetails.SubscriptionOfferDetails pickSubscriptionOffer(
+            ProductDetails productDetails,
+            String basePlanIdHint,
+            String productId
+    ) {
+        List<ProductDetails.SubscriptionOfferDetails> offers = productDetails.getSubscriptionOfferDetails();
+        if (offers == null || offers.isEmpty()) {
+            return null;
+        }
+
+        if (basePlanIdHint != null && !basePlanIdHint.isEmpty()) {
+            for (ProductDetails.SubscriptionOfferDetails o : offers) {
+                if (basePlanIdHint.equals(o.getBasePlanId())) {
+                    return o;
+                }
+            }
+        }
+
+        if (productId != null && productId.contains("yearly")) {
+            for (ProductDetails.SubscriptionOfferDetails o : offers) {
+                String bid = o.getBasePlanId();
+                if (bid != null && (bid.contains("yearly-v2") || bid.endsWith("-v2"))) {
+                    return o;
+                }
+            }
+            for (ProductDetails.SubscriptionOfferDetails o : offers) {
+                if (o.getPricingPhases() == null || o.getPricingPhases().getPricingPhaseList().isEmpty()) {
+                    continue;
+                }
+                String period = o.getPricingPhases().getPricingPhaseList().get(0).getBillingPeriod();
+                if ("P1Y".equals(period)) {
+                    return o;
+                }
+            }
+        }
+
