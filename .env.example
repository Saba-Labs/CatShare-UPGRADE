# ─── Website builder (optional — use while Supabase is slow/unavailable) ───
# Homepage layouts save to localStorage when USE_LOCAL_HOMEPAGE_STORE is true in code.
# Set this to skip cloud profile sync on /store/homepage (faster load when DB is unhealthy).
# VITE_OFFLINE_BUILDER=true

# ─── Supabase (required for login + DB) ─────────────────────────────────────
# Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# App origin for R2 presigned / delete API calls (web). Often same as deploy URL or empty for relative paths.
# VITE_APP_URL=https://your-app.vercel.app

# Public web URL for share links and the Store page “your link” field. Set in Vercel to your production domain
# (e.g. https://catshare.vercel.app). Required for Capacitor/Android where window.location is localhost.
# Also used as the base for signup email confirmation redirect: {VITE_PUBLIC_WEB_BASE_URL}/email-confirmed
# → add that full URL under Supabase → Authentication → URL Configuration → Redirect URLs.
# VITE_PUBLIC_WEB_BASE_URL=https://catshare.vercel.app

# REQUIRED for Android/iOS (Capacitor): absolute URL to your Vercel app — product image upload uses /api/upload-product-image
# (Web can omit if same-origin; native WebView is https://localhost so relative /api will never hit Vercel.)
# VITE_BACKEND_URL=https://your-app.vercel.app

# Optional: public R2 base for URL parsing in delete helpers
# VITE_R2_PUBLIC_BASE_URL=https://cdn.example.com

# ─── Firebase (optional: analytics, messaging, functions — not used for sign-in) ─
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Vercel / server only (set in Vercel Environment Variables, not in Vite) ─
# Optional: seller subdomain error failover (middleware.ts). Probes the page; only non-2xx/3xx → 302 to path-based store on my.
# Set to false to disable: STOREFRONT_SUBDOMAIN_REDIRECT=false
# STOREFRONT_FALLBACK_ORIGIN=https://my.catshare.app
# STOREFRONT_ROOT_DOMAIN=catshare.app
# Custom store domains (Vercel project — server only):
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=   # optional, if project is under a team
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# INTEGRATIONS_ENCRYPTION_KEY=long_random_secret_for_shiprocket_tokens
# SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
# R2_ENDPOINT=   # optional override; else https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# FIREBASE_SERVICE_ACCOUNT_JSON=  # still used by verify-purchase / Google Play APIs where applicable
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=  # Android billing verification on Node backend
